{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "district-library: Conway Public Schools public record",
  "description": "Conway Public Schools' (Conway, Arkansas) public record: school board minutes, the board policy manual, personnel policies, superintendent contracts, salary schedules, monthly financial reports since 2018, school improvement plans, handbooks, calendars, board meeting transcripts, and school live-feed posts. One record per document pointing to the district's original, plus extracted text.",
  "url": "https://github.com/conway-claws/district-library",
  "sameAs": "https://github.com/conway-claws/district-library",
  "creator": {
    "@type": "Organization",
    "name": "Conway CLAWS",
    "url": "https://conwaypto.org"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Conway CLAWS",
    "url": "https://conwaypto.org"
  },
  "license": "https://github.com/conway-claws/district-library/blob/main/LICENSE",
  "isAccessibleForFree": true,
  "keywords": [
    "Conway Public Schools",
    "school board",
    "public records",
    "board minutes",
    "board policy",
    "school district finance",
    "Arkansas",
    "civic data"
  ],
  "spatialCoverage": {
    "@type": "Place",
    "name": "Conway, Arkansas, United States"
  },
  "temporalCoverage": "2018/..",
  "distribution": [
    {
      "@type": "DataDownload",
      "name": "catalog.jsonl, one JSON object per record",
      "encodingFormat": "application/jsonl",
      "contentUrl": "https://raw.githubusercontent.com/conway-claws/district-library/main/catalog.jsonl"
    },
    {
      "@type": "DataDownload",
      "name": "monthly checksummed release (vYYYY.MM): catalog, extracted text, exports",
      "encodingFormat": "application/zip",
      "contentUrl": "https://github.com/conway-claws/district-library/releases/latest"
    },
    {
      "@type": "DataDownload",
      "name": "MCP server (single stdlib Python file; reads the library over HTTPS)",
      "encodingFormat": "text/x-python",
      "contentUrl": "https://raw.githubusercontent.com/conway-claws/district-library/main/bin/mcp_server.py"
    }
  ]
}
